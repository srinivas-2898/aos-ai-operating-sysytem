# ─── AOS AI Operating System — Environment Variables ───────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── Chat / Generation AI Providers ──────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=

# ── Image Generation ─────────────────────────────────────────────────────────
HF_TOKEN=
STABILITY_API_KEY=
FAL_KEY=
POLLINATIONS_API_KEY=
GEMINI_IMAGE_KEY=

# ── Model Overrides (optional) ───────────────────────────────────────────────
GEMINI_MODEL=gemini-3.6-flash
OPENROUTER_MODEL=openrouter/auto
GROQ_MODEL=llama-3.3-70b-versatile

# ── Supabase (server-side only — NEVER expose service role key to browser) ───
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── GitHub OAuth ─────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=

# ── IDE Copilot — Proxima (local) ────────────────────────────────────────────
PROXIMA_API_KEY=
PROXIMA_MCP_URL=http://localhost:3210
PROXIMA_SERVER_URL=http://localhost:3210

# ── AOS Assistant (new feature) ──────────────────────────────────────────────
# No additional keys required — reuses providers above.
# Voice I/O uses browser Web Speech API + SpeechSynthesis (no keys needed).